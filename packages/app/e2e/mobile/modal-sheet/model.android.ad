# FORM_URL is paseo://new?serverId=<connected-serverId>.
# Gesture coordinates target a 1080x1920 Android emulator at density 420.
context platform=android timeout=60000 retries=0
env APP_ID=sh.paseo.debug

open "${APP_ID}" "${FORM_URL}"
wait "id=\"combined-model-selector\"" 20000
# The gauge opens the effort overlay; its label opens the Advanced sheet.
press "id=\"combined-model-selector\""
wait "id=\"agent-effort-advanced\"" 10000
press "id=\"agent-effort-advanced\""
wait "id=\"agent-effort-model\"" 10000
gesture pan 540 790 0 960 500
wait "id=\"combined-model-selector\"" 3000

# Reopen Advanced and its model browser; dismissing the sheet closes both pages.
press "id=\"combined-model-selector\""
wait "id=\"agent-effort-advanced\"" 10000
press "id=\"agent-effort-advanced\""
wait "id=\"agent-effort-model\"" 10000
press "id=\"agent-effort-model\""
wait "id=\"agent-model-browser\"" 10000
gesture pan 540 790 0 960 500
wait "id=\"combined-model-selector\"" 3000
# The overlay closes on a downward swipe over the slider's label.
press "id=\"combined-model-selector\""
wait "id=\"agent-intelligence-overlay\"" 10000
gesture pan 540 1500 0 300 300
wait "id=\"combined-model-selector\"" 3000
close
